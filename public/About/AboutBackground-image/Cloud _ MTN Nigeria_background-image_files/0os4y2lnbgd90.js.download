y.",href:a.ONBOARDING_URL}],f=[{id:1,icon:r,title:"Data residency",description:"100% hosted within Nigeria for compliance and peace of mind"},{id:2,icon:i,title:"Local billing:",description:"Transparent, predictable pricing in Naira (NGN)"},{id:3,icon:r,title:"Hybrid Read",description:"Easily integrate with your existing on-prem infrastructure"},{id:4,icon:n,title:"Flexible OS Choices",description:"Choose popular distributions or Windows Server. Bring Your Own Image or License."}],m=[{id:1,icon:r,title:"Block & Object Storage",description:"Flexible options for apps, databases, media, and backups."},{id:2,icon:i,title:"Local Data Hosting",description:"Your data stays in Nigeria for faster access and regulatory compliance."},{id:3,icon:r,title:"Snapshots & Backups",description:"Easy point-in-time recovery and automated data protection "},{id:4,icon:n,title:"Elastic Scalability",description:"Increase or decrease storage as your needs change "}],g=[{id:1,icon:r,title:"Virtual Private Cloud (VPC)",description:"Isolated, customizable networks for your cloud resources "},{id:2,icon:i,title:"Cloud Load Balancers",description:"Distribute traffic intelligently for scale and reliability"},{id:3,icon:r,title:"Firewalls & Security Groups",description:"Granular control over inbound and outbound traffic  "},{id:4,icon:n,title:"Private Connectivity",description:"Direct, high-throughput links to MTN Cloud via VPN or Direct Connect  "}];e.s(["TABS",0,[{label:"All",value:"All"},{label:"SMB",value:"SMB"},{label:"Enterprise",value:"Enterprise"},{label:"Startup",value:"Startup"},{label:"Public sector",value:"Public sector"}],"bestPracticesData",0,[{id:"roles",title:"Roles",practice:"Create reusable role templates per persona (e.g., Ops, Developer, Finance)",area:"Roles",emoji:"🔐",features:[{id:"role-1",description:"Define role templates based on common job functions and responsibilities"},{id:"role-2",description:"Implement least-privilege principle—grant only necessary permissions"},{id:"role-3",description:"Use clear, consistent naming conventions (e.g., Ops-VM-Manager, Finance-ViewOnly)"},{id:"role-4",description:"Regularly audit and update role permissions to match organizational changes"}]},{id:"users",title:"Users",practice:"Enforce MFA and periodically review active accounts",area:"Users",emoji:"👥",features:[{id:"user-1",description:"Enable Multi-Factor Authentication (MFA) for all user accounts"},{id:"user-2",description:"Conduct quarterly access reviews to identify inactive or unnecessary accounts"},{id:"user-3",description:"Implement automated deprovisioning workflows for departing employees"},{id:"user-4",description:"Maintain audit logs of user actions for compliance and security monitoring"}]},{id:"integrations",title:"Integrations",practice:"Secure integration credentials with Cypher or Vault",area:"Integrations",emoji:"🌐",features:[{id:"integration-1",description:"Store API keys and credentials in secure vault solutions (e.g., AWS Secrets Manager, Vault)"},{id:"integration-2",description:"Rotate credentials regularly—implement automated rotation schedules"},{id:"integration-3",description:"Use service accounts with minimal required permissions"},{id:"integration-4",description:"Monitor and log all integration access attempts and failures"}]},{id:"settings",title:"Settings",practice:"Set default instance limits to prevent quota overrun",area:"Settings",emoji:"⚙️",features:[{id:"settings-1",description:"Configure default resource quotas per tenant to prevent unexpected costs"},{id:"settings-2",description:"Enable auto-scaling policies with defined min/max boundaries"},{id:"settings-3",description:"Set up billing alerts and notifications for quota thresholds"},{id:"settings-4",description:"Review and adjust default settings quarterly based on usage patterns"}]},{id:"multi-tenant",title:"Multi-Tenant",practice:"Create isolated Roles, Users, and Integrations for each enterprise tenant",area:"Multi-Tenant",emoji:"🧩",features:[{id:"tenant-1",description:"Implement strict resource isolation between tenants"},{id:"tenant-2",description:"Create tenant-specific role hierarchies to prevent cross-tenant access"},{id:"tenant-3",description:"Use network segmentation and security groups to enforce boundaries"},{id:"tenant-4",description:"Regularly audit tenant configurations for compliance and security"}]}],"companySizeOptions",0,[{value:"1-50",label:"1-50"},{value:"51-200",label:"51-200"},{value:"201-1000",label:"201-1000"},{value:"1000+",label:"1000+"},{value:"Government",label:"Government"}],"footerSections",0,[{title:"Our Company",links:[{label:"About MTN",href:"https://www.mtn.ng/about/"},{label:"Code of Ethics",href:"https://www.mtn.ng/about/our-code-of-ethics/"},{label:"Privacy & Data Protection",href:"https://www.mtn.ng/legal/privacy-and-data-protection-policy/"}]},{title:"Legal",links:[{label:"Privacy Policy & Cookies",href:"https://www.mtn.ng/legal/privacy-and-data-protection-policy/"},{label:"Terms & Conditions",href:"https://www.mtn.ng/legal/"}]},{title:"Explore MTN",links:[{label:"eShop",href:"https://shop.mtn.ng/"},{label:"Play",href:"https://play.mtn.ng/"},{label:"mPulse",href:"https://mpulse.mtn.ng/"},{label:"MoMo",href:"https://www.momo.ng/"},{label:"Business",href:"https://selfservice.mtn.ng/business"}]},{title:"Help",links:[{label:"Store Locator",href:"https://selfservice.mtn.ng/store-locator"},{label:"Coverage Map",href:"https://external.mtnncoveragelocator.com/"},{label:"Contact us",href:"https://selfservice.mtn.ng/contact-us"},{label:"FAQ",href:"https://shop.mtn.ng/helpcenter/help/eshop-faqs/"}]}],"interestOptions",0,[{value:"I'm from a large enterprise and would like to speak to sales",label:"I'm from a large enterprise and would like to speak to sales"},{value:"I'm from a government agency and would like to speak to sales",label:"I'm from a government agency and would like to speak to sales"},{value:"I'm exploring cloud options and want early access",label:"I'm exploring cloud options and want early access"},{value:"I want to try MTN Cloud as an individual developer",label:"I want to try MTN Cloud as an individual developer"},{value:"I want to use MTN Cloud for my startup or small business",label:"I want to use MTN Cloud for my startup or small business"},{value:"Other",label:"Other"}],"onboardingStepsData",0,[{id:"login",title:"Logging In for the First Time",emoji:"🔑",content:[{id:"login-1",title:"Welcome Email Details",description:"You will receive a welcome email with: Portal URL (https://cloud.mtn.ng), Username (Your registered email address), and Password instructions",type:"info"},{id:"login-2",title:"Step 1: Go to Login Page",description:"Navigate to https://cloud.mtn.ng/login",type:"steps"},{id:"login-3",title:"Step 2: Enter Credentials",description:"Enter your email and password, then click Sign In",type:"steps"},{id:"login-4",title:"Step 3: Access Dashboard",description:"You will land on the MTN Cloud dashboard",type:"steps"},{id:"login-5",title:"Security Tip",description:"Enable 2FA immediately after login to secure your account",type:"tip"}]},{id:"profile",title:"Updating Your User Profile",emoji:"👤",content:[{id:"profile-1",title:"Menu Path",description:'Profile Icon (top-right) → "My Profile"',type:"info"},{id:"profile-2",title:"Update Profile Information",description:"Update your display name, email, and contact number",type:"info"},{id:"profile-3",title:"Set Preferences",description:"Set your time zone and language preferences",type:"info"},{id:"profile-4",title:"View Activity",description:"View recent login sessions and API token access",type:"info"},{id:"profile-5",title:"Time Zone Tip",description:"Accurate time zones help ensure that scheduled backups, logs, and reports align with your operational hours",type:"tip"}]},{id:"2fa",title:"Enabling Two-Factor Authentication",emoji:"🔐",content:[{id:"2fa-1",title:"What is 2FA?",description:"Two-Factor Authentication adds a critical security layer to your MTN Cloud account. It prevents unauthorized access even if your password is compromised",type:"info"},{id:"2fa-2",title:"Step 1: Navigate to Settings",description:'Click your profile icon → "My Profile"',type:"steps"},{id:"2fa-3",title:"Step 2: Open Security Tab",description:"Navigate to the Security tab",type:"steps"},{id:"2fa-4",title:"Step 3: Enable 2FA",description:"Click Enable Two-Factor Authentication",type:"steps"},{id:"2fa-5",title:"Step 4: Scan QR Code",description:"Scan the QR code using: Google Authenticator, Microsoft Authenticator, or Authy",type:"steps"},{id:"2fa-6",title:"Step 5: Enter OTP",description:"Enter the 6-digit OTP shown in the app and click Confirm",type:"steps"},{id:"2fa-7",title:"Success",description:"2FA is now activated — you’ll need an OTP on every login",type:"info"},{id:"2fa-8",title:"Team Recommendation",description:"We highly recommend enabling 2FA for all team members",type:"tip"}]},{id:"environment",title:"Understanding the MTN Cloud Environment",emoji:"🏢",content:[{id:"env-1",title:"Cloud Zone",description:'A logical region or data center (e.g., "MTN Lagos Zone")',type:"info"},{id:"env-2",title:"Group",description:"A collection of resources under a specific team/project",type:"info"},{id:"env-3",title:"Tenant",description:"Isolated environment for business units, customers, or organizations",type:"info"},{id:"env-4",title:"Role",description:"Permission level assigned to users (e.g., Admin, Viewer, DevOps)",type:"info"},{id:"env-5",title:"Multi-Tenant Architecture",description:"Each tenant has its own secure boundary — resources, users, billing, and quotas are isolated",type:"info"},{id:"env-6",title:"Ideal For",description:"Enterprises with multiple departments, Managed Service Providers, and Resellers or software vendors",type:"info"}]},{id:"users",title:"Adding and Managing Users",emoji:"👥",content:[{id:"users-1",title:"Menu Path",description:"Administration → Users",type:"info"},{id:"users-2",title:"Step 1: Click Add User",description:"Click + Add User",type:"steps"},{id:"users-3",title:"Step 2: Enter Details",description:"Enter Full Name, Email Address, Role (Admin, DevOps, Viewer, etc.), and assign to a Group (if applicable)",type:"steps"},{id:"users-4",title:"Step 3: Save User",description:"Click Save. The user will receive a secure invitation email with login steps",type:"steps"},{id:"users-5",title:"Role-Based Access Control",description:"Fine-grained permission per user to limit access to compute, storage, billing, etc.",type:"info"},{id:"users-6",title:"Advanced Features",description:"Enforce policy compliance across departments with advanced policy controls for access expiration, activity auditing, and API scoping",type:"info"}]},{id:"billing",title:"Understanding MTN Cloud Billing",emoji:"💰",content:[{id:"billing-1",title:"Billing Features",description:"MTN Cloud offers flexible pricing, transparent usage metering, and Naira-based billing, eliminating FX exposure",type:"info"},{id:"billing-2",title:"Billable Services",description:"Compute (vCPU & RAM) by the Month, Block storage (per GB/month), Object storage (per GB/month), Public IPs and snapshot storage, Managed services (e.g. app templates)",type:"info"},{id:"billing-3",title:"Menu Path",description:"Operations → Reports → Usage",type:"info"},{id:"billing-4",title:"Export Reports",description:"Export CSV/PDF reports for finance reconciliation and internal chargeback",type:"info"},{id:"billing-5",title:"Billing Models",description:"Pay-As-You-Go: Track real-time usage",type:"info"},{id:"billing-6",title:"Prepaid Bundles",description:"Ideal for projects with fixed budgets",type:"info"},{id:"billing-7",title:"Enterprise Plans",description:"Enterprise Commitment Plans for large-scale deployments",type:"info"},{id:"billing-8",title:"Contact Information",description:"Contact your MTN Cloud Account Manager for tailored pricing",type:"tip"}]},{id:"networking",title:"Networking & Public Access",emoji:"📡",content:[{id:"networking-1",title:"Default Network Config